{
  "name": "fun-house-pinball-scripts",
  "private": true,
  "description": "Tooling scripts for CI and the simulator, written with zx",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:stray-files": "node .github/scripts/check-stray-files.mjs",
    "build:sim": "node sim/build.mjs",
    "serve:sim": "node sim/serve.mjs",
    "build:site": "node site/build.mjs",
    "test:site": "node --test site/shopping-list.test.mjs site/parts/counts.test.mjs sim/serve.test.mjs sim/web/trace/homography.test.mjs sim/web/trace/shapes.test.mjs",
    "serve:site": "node sim/serve.mjs --dir=../site/generated",
    "render:sounds": "node sim/render-sounds.mjs",
    "check:sounds": "node sim/render-sounds.mjs --check",
    "import:samples": "node sim/import-samples.mjs",
    "export:3d": "node hardware/export-3d.mjs",
    "check:3d": "node hardware/export-3d.mjs --check",
    "ci:install-openscad": "node .github/scripts/install-openscad.mjs",
    "ci:install-ffmpeg": "node .github/scripts/ci.mjs install-ffmpeg",
    "ci:install-avr": "node .github/scripts/ci.mjs install-avr",
    "ci:toolchain": "node .github/scripts/ci.mjs toolchain",
    "ci:firmware-toolchain": "node .github/scripts/ci.mjs firmware-toolchain",
    "ci:core": "node .github/scripts/ci.mjs core",
    "ci:firmware": "node .github/scripts/ci.mjs firmware"
  },
  "devDependencies": {
    "zx": "8.8.5"
  }
}
